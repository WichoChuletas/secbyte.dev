---
const { size = 'md' } = Astro.props;

const sizes = {
	sm: { chevron: '1rem', text: '0.9rem', cursor: '0.55rem', gap: '0.4rem' },
	md: { chevron: '1.3rem', text: '1.1rem', cursor: '0.7rem', gap: '0.5rem' },
};

const s = sizes[size] ?? sizes.md;
---

<a href="/" class="logo" aria-label="secbyte.dev">
	<span class="chevron" style={`font-size:${s.chevron}`}>&gt;</span>
	<span class="wordmark" style={`font-size:${s.text}; gap:${s.gap}`}>
		<span class="secbyte">secbyte</span><span class="dev">.dev</span>
		<span class="cursor" style={`width:${s.cursor}; height:calc(${s.text} * 0.85)`}></span>
	</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
	}

	.logo:hover {
		text-decoration: none;
	}

	.chevron {
		font-weight: 600;
		color: var(--color-accent);
		line-height: 1;
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.secbyte {
		color: var(--color-text);
	}

	.dev {
		color: var(--color-text-muted);
	}

	.cursor {
		display: inline-block;
		background: var(--color-accent);
		margin-left: 0.5rem;
		animation: blink 1.1s step-start infinite;
	}

	@keyframes blink {
		0%, 49% { opacity: 1; }
		50%, 100% { opacity: 0; }
	}
</style>
