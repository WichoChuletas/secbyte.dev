---
const { slug } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<section class="comments" data-comments={slug}>
	<h2 class="heading">Comments</h2>

	<div class="comments-list" id="comments-list">
		<p class="status" id="comments-status">Loading comments…</p>
	</div>

	<form class="comments-form" id="comments-form">
		<input type="text" name="name" placeholder="Name" maxlength="60" required />
		<textarea name="message" placeholder="Write a comment…" maxlength="1000" rows="4" required></textarea>
		<div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark"></div>
		<button type="submit">Post comment</button>
		<p class="error" id="comments-error" hidden></p>
	</form>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script src="/comments.js" type="module"></script>

<style>
	.comments {
		margin-top: var(--space-5);
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.heading {
		font-size: 1rem;
		font-weight: 600;
	}

	.comments-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	/* .status, .comment* are applied to elements created client-side in comments.js,
	   so they need :global() — Astro's scoped-style attribute is never stamped on them. */
	:global(.status) {
		color: var(--color-text-faint);
		font-size: 0.85rem;
	}

	:global(.comment) {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-bottom: var(--space-2);
		border-bottom: 1px solid var(--color-border);
	}

	:global(.comment-header) {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
	}

	:global(.comment-name) {
		font-weight: 600;
		font-size: 0.85rem;
	}

	:global(.comment-date) {
		color: var(--color-text-faint);
		font-size: 0.75rem;
	}

	:global(.comment-message) {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		white-space: pre-wrap;
	}

	.comments-form {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 32rem;
	}

	.comments-form input,
	.comments-form textarea {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 0.85rem;
		padding: 0.6rem 0.75rem;
		border-radius: 4px;
		resize: vertical;
	}

	.comments-form input:focus,
	.comments-form textarea:focus {
		outline: 1px solid var(--color-accent);
	}

	.comments-form button {
		align-self: flex-start;
		background: var(--color-accent);
		color: var(--color-bg);
		border: none;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 0.85rem;
		padding: 0.55rem 1.1rem;
		border-radius: 4px;
		cursor: pointer;
	}

	.comments-form button:disabled {
		opacity: 0.6;
		cursor: default;
	}

	.error {
		color: #f2716f;
		font-size: 0.8rem;
	}
</style>
