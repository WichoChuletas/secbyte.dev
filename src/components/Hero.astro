---
import SocialLinks from './SocialLinks.astro';
import { socialLinks } from '../data/socialLinks.js';

const {
	greeting = 'Hi — I\'m Fernando',
	bio = "I write practical, no-nonsense guides on networking and security — from CCNA-level fundamentals to home-lab firewall configs. This is where I put the notes I wish existed when I was learning.",
} = Astro.props;
---

<section class="hero">
	<h1>{greeting}</h1>
	<p class="bio">{bio}</p>

	<div class="identity">
		<div class="avatar" aria-hidden="true">S</div>
		<SocialLinks links={socialLinks} />
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	h1 {
		font-size: 1.1rem;
		font-weight: 600;
	}

	.bio {
		color: var(--color-text-muted);
		max-width: 52ch;
	}

	.identity {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		margin-top: 0.5rem;
	}

	.avatar {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.8rem;
		color: var(--color-text-muted);
		flex-shrink: 0;
	}
</style>
