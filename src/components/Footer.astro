---
import { footerLinks } from '../data/footerLinks.js';
import { socialLinks } from '../data/socialLinks.js';
import Logo from './Logo.astro';

const columns = [
	{ heading: 'Navigate', links: footerLinks },
	{ heading: 'Social', links: socialLinks },
];
---

<footer class="footer">
	<div class="wrapper footer-inner">
		<Logo size="sm" />

		<div class="columns">
			{columns.map((column) => (
				<ul class="column">
					{column.links.map((link) => (
						<li><a href={link.url} target={link.url?.startsWith('http') ? '_blank' : undefined} rel={link.url?.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label}</a></li>
					))}
				</ul>
			))}
		</div>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-border);
		margin-top: var(--space-6);
		padding-block: var(--space-4);
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem;
	}

	.columns {
		display: flex;
		gap: 3rem;
		flex-wrap: wrap;
	}

	.column {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}
</style>
